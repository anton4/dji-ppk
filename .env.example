# Host directories mounted into the containers.
# FLIGHTS_DIR is mounted read-write at /data/flights; each DJI flight folder lives below it.
FLIGHTS_DIR=.
# BASE_DIR is mounted read-only at /data/base; put downloaded ESTPOS RINEX files here.
BASE_DIR=./data/base
# OUT_DIR is mounted at /data/out; used only with PPK_IN_PLACE=0 (results in /data/out/<flight-folder-name>/)
OUT_DIR=./data/out
# 1: write geo.txt & co into the flight folder next to the photos (default). 0: write to OUT_DIR.
PPK_IN_PLACE=1
# Watcher poll interval in seconds
PPK_POLL_SECONDS=30
# RTKLIB git ref to build (tag or branch of rtklibexplorer/RTKLIB): v2.5.1 (default), demo5, b34L ...
RTKLIB_REF=v2.5.1
# Carrier frequency slots compiled into RTKLIB: 4 (default) enables l1+l2+l5+l6, 3 is the upstream default
RTKLIB_NFREQ=4
