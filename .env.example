# Host directories mounted into the containers.
# FLIGHTS_DIR is mounted read-only at /data/flights; each DJI flight folder lives directly below it.
FLIGHTS_DIR=.
# BASE_DIR is mounted read-only at /data/base; put downloaded ESTPOS RINEX files here.
BASE_DIR=./data/base
# OUT_DIR is mounted read-write at /data/out; results are written to /data/out/<flight-folder-name>/
OUT_DIR=./data/out
# Watcher poll interval in seconds
PPK_POLL_SECONDS=30
# RTKLIB git ref to build (tag or branch of rtklibexplorer/RTKLIB): v2.5.1 (default), demo5, b34L ...
RTKLIB_REF=v2.5.1
