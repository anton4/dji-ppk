#!/usr/bin/env bash
# dji-ppk: one entry point for the whole flow. Runs on the host, drives the two containers.
#
#   ./dji-ppk                     interactive menu: status table, tick folders, apply run / download / order / process
#   ./dji-ppk status              one line per flight folder: sessions, photos, base, result, next step
#   ./dji-ppk run <folder>        order the Virtual RINEX if needed, then process (geo.txt & co)
#   ./dji-ppk run --all           the same for every folder that is not done yet
#   ./dji-ppk order <folder>      order + download only            ./dji-ppk process <folder>   process only
#   ./dji-ppk download <folder>   download an order that already exists on the portal (never orders)
#   ./dji-ppk window <folder>     print the order parameters       ./dji-ppk dry-run <folder>   fill the form, do not submit
#   ./dji-ppk watch               start the folder watcher and follow its log
#   ./dji-ppk build               (re)build both images
#
# <folder> is a folder name under FLIGHTS_DIR (see .env), or any path to it.
set -euo pipefail
cd "$(dirname "$0")"

if [[ -t 1 ]]; then B=$'\e[1m'; D=$'\e[2m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; N=$'\e[0m'; else B=""; D=""; G=""; Y=""; R=""; N=""; fi

die() { echo "${R}error:${N} $*" >&2; exit 1; }
compose() { docker compose --profile cli "$@"; }
image_tag() { local ref; ref="$(grep -E '^RTKLIB_REF=' .env 2>/dev/null | cut -d= -f2)"; echo "dji-ppk:${ref:-v2.5.1}"; }
ensure_images() { # build missing images with visible progress; a silent auto-build looks like a hang (RTKLIB compiles for minutes)
  local -a need=()
  docker image inspect "$(image_tag)" >/dev/null 2>&1 || need+=(ppk)
  if [[ "${1:-}" == "estpos" ]]; then docker image inspect dji-ppk-estpos >/dev/null 2>&1 || need+=(ppk-estpos); fi
  if (( ${#need[@]} )); then
    echo "${Y}image(s) not built yet: ${need[*]}. Building now (first run compiles RTKLIB, several minutes) ...${N}" >&2
    docker compose --profile cli build "${need[@]}" || die "image build failed"
  fi
}
# -T: no pseudo-TTY, stdin from /dev/null: the containers must never swallow the keystrokes of the menu
ppk() { ensure_images; compose run --rm -T ppk "$@" </dev/null; }
estpos() { ensure_images estpos; compose run --rm -T ppk-estpos "$@" </dev/null; }

need_env() {
  [[ -f .env ]] || die ".env is missing: cp .env.example .env and set FLIGHTS_DIR (and ESTPOS_USER / ESTPOS_PASSWORD for ordering)"
  command -v docker >/dev/null || die "docker is not installed"
  docker compose version >/dev/null 2>&1 || die "docker compose (v2 plugin) is not available"
  command -v python3 >/dev/null || die "python3 is needed on the host for the menu"
}
need_creds() {
  grep -qE '^ESTPOS_USER=.+' .env && grep -qE '^ESTPOS_PASSWORD=.+' .env || die "ESTPOS_USER / ESTPOS_PASSWORD are not set in .env (needed to order a Virtual RINEX)"
}
cpath() { # folder name or host path -> path inside the containers
  local f="${1%/}"
  echo "/data/flights/$(basename "$f")"
}

cmd_status() { need_env; ppk status /data/flights "$@"; }

STATUS_JSON=""
scan() { # one container run; the table and the menu list are both rendered from this JSON
  echo "${D}scanning FLIGHTS_DIR ...${N}" >&2
  STATUS_JSON="$(ppk status /data/flights --json 2>/dev/null)" || die "cannot list flights (is the image built? ./dji-ppk build)"
}
render_table() {
  python3 -c '
import json, sys
rows = json.load(sys.stdin)
if not rows:
    print("no flight folders (OBS/NAV/MRK triplets) found"); sys.exit()
head = ["folder", "sess/photos", "flown", "base", "result", "next"]
table = [head] + [[r["folder"], str(r["sessions"]) + "/" + str(r["photos"]), r["flown"], r["base"], r["result"], r["next"]] for r in rows]
w = [max(len(str(x[i])) for x in table) for i in range(len(head))]
for n, row in enumerate(table):
    print("  ".join(str(c).ljust(k) for c, k in zip(row, w)).rstrip())
    if n == 0: print("  ".join("-" * k for k in w))
exp = [r["folder"] for r in rows if r["next"] == "expired"]
if exp: print("\nexpired (older than 90 days, ESTPOS has no RINEX for these): " + ", ".join(exp))' <<< "$STATUS_JSON"
}
pending_folders() { # names of folders whose next step is not "done"
  python3 -c '
import json, sys
for r in json.load(sys.stdin):
    if r["next"] not in ("done", "photos", "expired"):
        print(r["folder"])' <<< "$STATUS_JSON"
}
all_folders() {
  python3 -c '
import json, sys
for r in json.load(sys.stdin):
    print(r["folder"] + "\t" + r["next"])' <<< "$STATUS_JSON"
}

cmd_order()    { need_env; need_creds; estpos estpos-order "$(cpath "$1")" "${@:2}"; }
cmd_download() { need_env; need_creds; estpos estpos-download "$(cpath "$1")" "${@:2}"; }
cmd_dryrun()  { need_env; need_creds; estpos estpos-order "$(cpath "$1")" --dry-run "${@:2}"; }
cmd_window()  { need_env; ppk estpos-window "$(cpath "$1")" "${@:2}"; }
cmd_process() { need_env; ppk process "$(cpath "$1")" "${@:2}"; }

cmd_run() {
  need_env
  local f="$1"
  echo "${B}== $f: base file${N}"
  if grep -qE '^ESTPOS_USER=.+' .env; then
    estpos estpos-order "$(cpath "$f")" || { echo "${R}ordering the Virtual RINEX failed for $f${N}" >&2; return 1; }
  else
    echo "${Y}ESTPOS credentials not set in .env: skipping the order step, using whatever base file is in the folder${N}"
  fi
  echo "${B}== $f: processing${N}"
  ppk process "$(cpath "$f")" || { echo "${R}processing failed for $f${N}" >&2; return 1; }
}

cmd_run_all() {
  [[ -n "$STATUS_JSON" ]] || scan
  local list; list="$(pending_folders)"
  [[ -n "$list" ]] || { echo "${G}nothing to do: every folder is done${N}"; return 0; }
  while IFS= read -r f; do cmd_run "$f"; done <<< "$list"
}

cmd_watch() { need_env; docker compose up -d ppk-watch && docker compose logs -f ppk-watch; }
cmd_build() { compose build ppk ppk-estpos; }

menu() {
  need_env
  local -a names nexts sel
  local rescan=1 input tok i
  while true; do
    if (( rescan )); then
      echo; echo "${B}Flight folders under FLIGHTS_DIR${N}"
      scan
      names=(); nexts=(); sel=()
      while IFS=$'\t' read -r n x; do [[ -n "$n" ]] && { names+=("$n"); nexts+=("$x"); }; done < <(all_folders)
      for i in "${!names[@]}"; do   # pre-tick everything that has a sensible next step
        case "${nexts[$i]}" in order|process|reprocess) sel[$i]=1 ;; *) sel[$i]=0 ;; esac
      done
      rescan=0
    fi
    (( ${#names[@]} )) || { echo "no flight folders found under FLIGHTS_DIR"; exit 0; }
    echo
    render_table
    echo "${D}next: order = no base file yet, photos = photos still missing in the folder (copy finished?), process/reprocess = run it,${N}"
    echo "${D}      done = nothing to do, expired = older than 90 days, ESTPOS has no RINEX for it any more (only a base file already in the folder helps)${N}"
    echo
    for i in "${!names[@]}"; do
      local mark=" "; (( sel[$i] )) && mark="${G}x${N}"
      printf "  %2d) [%s] %s  ${D}(next: %s)${N}\n" "$((i + 1))" "$mark" "${names[$i]}" "${nexts[$i]}"
    done
    echo
    echo "${B}Tick:${N} numbers toggle (e.g. ${B}1 3${N} or ${B}2-4${N}), ${B}a${N} = all pending, ${B}A${N} = all, ${B}n${N} = none"
    echo "${B}Then:${N} ${B}r${N} = run ticked (order base if needed + process)   ${B}d${N} = download base only   ${B}o${N} = order base only"
    echo "      ${B}p${N} = process only   ${B}w${N} = show order parameters   ${B}s${N} = rescan   ${B}W${N} = start the watcher   ${B}q${N} = quit"
    read -r -p "> " input || exit 0
    local -a picked=()
    for i in "${!names[@]}"; do (( sel[$i] )) && picked+=("${names[$i]}"); done
    case "$input" in
      q|Q) exit 0 ;;
      s|S) rescan=1; continue ;;
      W)   cmd_watch; rescan=1; continue ;;
      a)   for i in "${!names[@]}"; do case "${nexts[$i]}" in order|process|reprocess) sel[$i]=1 ;; *) sel[$i]=0 ;; esac; done; continue ;;
      A)   for i in "${!names[@]}"; do sel[$i]=1; done; continue ;;
      n|N) for i in "${!names[@]}"; do sel[$i]=0; done; continue ;;
      r|d|o|p|w)
        (( ${#picked[@]} )) || { echo "${Y}nothing ticked${N}"; continue; }
        for f in "${picked[@]}"; do
          echo; echo "${B}==== $f ====${N}"
          case "$input" in
            r) cmd_run "$f" || echo "${R}$f failed${N}" ;;
            d) cmd_download "$f" || echo "${R}$f failed${N}" ;;
            o) cmd_order "$f" || echo "${R}$f failed${N}" ;;
            p) cmd_process "$f" || echo "${R}$f failed${N}" ;;
            w) cmd_window "$f" || echo "${R}$f failed${N}" ;;
          esac
        done
        [[ "$input" == "w" ]] || rescan=1
        continue ;;
      *)
        for tok in $input; do
          if [[ "$tok" =~ ^[0-9]+$ ]]; then
            (( tok >= 1 && tok <= ${#names[@]} )) && sel[$((tok - 1))]=$(( 1 - sel[$((tok - 1))] )) || echo "${Y}no folder $tok${N}"
          elif [[ "$tok" =~ ^([0-9]+)-([0-9]+)$ ]]; then
            for (( i = BASH_REMATCH[1]; i <= BASH_REMATCH[2]; i++ )); do
              (( i >= 1 && i <= ${#names[@]} )) && sel[$((i - 1))]=$(( 1 - sel[$((i - 1))] ))
            done
          else
            echo "${Y}unknown input '$tok'${N}"
          fi
        done ;;
    esac
  done
}

case "${1:-}" in
  "")            menu ;;
  status)        shift; cmd_status "$@" ;;
  run)           shift; [[ $# -ge 1 ]] || die "usage: ./dji-ppk run <folder> | --all"
                 if [[ "$1" == "--all" ]]; then cmd_run_all; else cmd_run "$1"; fi ;;
  order)         shift; [[ $# -ge 1 ]] || die "usage: ./dji-ppk order <folder>"; cmd_order "$@" ;;
  download)      shift; [[ $# -ge 1 ]] || die "usage: ./dji-ppk download <folder>"; cmd_download "$@" ;;
  process)       shift; [[ $# -ge 1 ]] || die "usage: ./dji-ppk process <folder>"; cmd_process "$@" ;;
  window)        shift; [[ $# -ge 1 ]] || die "usage: ./dji-ppk window <folder>"; cmd_window "$@" ;;
  dry-run)       shift; [[ $# -ge 1 ]] || die "usage: ./dji-ppk dry-run <folder>"; cmd_dryrun "$@" ;;
  watch)         cmd_watch ;;
  build)         cmd_build ;;
  -h|--help|help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)             die "unknown command '$1' (try ./dji-ppk --help)" ;;
esac
