def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="dji-ppk", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    s = sub.add_parser("status")
    s.add_argument("--json", action="store_true")
    s = sub.add_parser("run")
    s.add_argument("folders", nargs="*")
    s.add_argument("--all", action="store_true")
    for name in ("order", "download", "process", "window", "dry-run", "survey"):
        s = sub.add_parser(name)
        s.add_argument("folder")
        s.add_argument("extra", nargs=argparse.REMAINDER)
    sub.add_parser("watch")
    s = sub.add_parser("build")
    s.add_argument("--fresh", action="store_true", help="rebuild without the cache (new ANTEX, base image updates)")
    known = {"status", "run", "order", "download", "process", "window", "dry-run", "survey", "watch", "build", "-h", "--help"}
    if argv and argv[0] not in known and not argv[0].startswith("-"):
        argv = ["run", *argv]  # ./dji-ppk <folder> ... = run: the default is to do everything
    if "--no-update" in argv:
        argv = [x for x in argv if x != "--no-update"]
    elif not argv or argv[0] not in ("-h", "--help"):
        self_update(argv)  # pulls a newer version and re-runs itself; images are rebuilt on first use when stale
    a = ap.parse_args(argv)
    check_upgrades(read_env())  # newer RTKLIB, Playwright, RNXCMP, Python, Debian or ANTEX than the images use

    if a.cmd is None:
        menu(need_env())
        return 0
    if a.cmd == "build":
        return act_build(a.fresh)
    env = need_env()
    if a.cmd == "status":
        rows = status_rows(env)
        if a.json:
            print(json.dumps(rows, indent=1))
        else:
            print(render_table(rows))
            print()
            print(legend())
        return 0
    if a.cmd == "watch":
        return act_watch(env)
    if a.cmd == "run":
        if a.all:
            return act_run_all(env)
        if not a.folders:
            die("usage: ./dji-ppk run <folder>... | --all")
        rc = 0
        for f in a.folders:
            banner(f)
            rc = max(rc, act_run(env, f))
        return rc
    fn = {"order": act_order, "download": act_download, "process": act_process, "window": act_window, "dry-run": act_dryrun,
          "survey": act_survey}[a.cmd]
    return fn(env, a.folder, *a.extra)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print()
        sys.exit(130)
