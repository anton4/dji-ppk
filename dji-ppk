import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
os.chdir(ROOT)

COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
_C = {"bold": "1", "dim": "2", "red": "31", "green": "32", "yellow": "33", "cyan": "36", "magenta": "35"}
NEXT_STYLE = {"done": ("green",), "order": ("yellow", "bold"), "photos": ("yellow",), "process": ("cyan", "bold"),
              "reprocess": ("cyan",), "survey": ("cyan", "bold"), "expired": ("red", "bold"), "no-times": ("red",)}
PENDING = ("order", "process", "reprocess", "survey")
FLIGHTS = "/data/flights"


def c(text: str, *styles: str) -> str:
    return "".join(f"\033[{_C[s]}m" for s in styles) + text + "\033[0m" if COLOR and styles else text


def die(msg: str, code: int = 1) -> None:
    print(c("error: ", "red", "bold") + msg, file=sys.stderr)
    sys.exit(code)


# ----------------------------------------------------------------------------- self-update

def _git(*args: str, timeout: int = 30) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], capture_output=True, text=True, timeout=timeout, cwd=ROOT)


def self_update(argv: list[str]) -> None:
    """git fetch; if the remote branch is ahead and the working tree is clean, git pull --ff-only and re-run this
    command with the new code. Anything unusual (offline, local edits, diverged) is reported and skipped."""
    if os.environ.get("DJI_PPK_NO_UPDATE") or not (ROOT / ".git").exists():
        return
    try:
        if _git("rev-parse", "--abbrev-ref", "@{u}").returncode != 0:
            return  # no upstream configured
        fetch = _git("fetch", "--quiet", timeout=40)
        if fetch.returncode != 0:
            print(c("update check skipped: git fetch failed (offline?)", "dim"), file=sys.stderr)
            return
        local = _git("rev-parse", "HEAD").stdout.strip()
        remote = _git("rev-parse", "@{u}").stdout.strip()
        if local == remote:
            return
        base = _git("merge-base", "HEAD", "@{u}").stdout.strip()
        if base != local:
            print(c("update skipped: local commits differ from the remote (git status / git pull by hand)", "yellow"), file=sys.stderr)
            return
        if _git("status", "--porcelain", "--untracked-files=no").stdout.strip():
            print(c("update skipped: you have local changes; commit or stash them, then run again", "yellow"), file=sys.stderr)
            return
        n = _git("rev-list", "--count", "HEAD..@{u}").stdout.strip()
        print(c(f"new version available ({n} commit{'s' if n != '1' else ''}); updating ...", "cyan", "bold"), file=sys.stderr)
        pull = _git("pull", "--ff-only", "--quiet", timeout=120)
        if pull.returncode != 0:
            print(c("update failed: " + (pull.stderr or pull.stdout).strip(), "red"), file=sys.stderr)
            return
        print(c("updated to " + _git("log", "-1", "--format=%h %s").stdout.strip(), "green"), file=sys.stderr)
    except (subprocess.TimeoutExpired, OSError) as exc:
        print(c(f"update check skipped: {exc}", "dim"), file=sys.stderr)
        return
    os.environ["DJI_PPK_NO_UPDATE"] = "1"
    os.execv(sys.executable, [sys.executable, str(Path(__file__).resolve()), *argv])  # run the new launcher


# ----------------------------------------------------------------------------- upgrade check

VERSION_CACHE = ROOT / ".version-check.json"  # newest published versions, refreshed once a day
VERSION_CACHE_HOURS = 24


def _vtuple(v: str) -> tuple[int, ...] | None:
    m = re.fullmatch(r"v?(\d+(?:\.\d+)*)", v.strip())
    return tuple(int(x) for x in m.group(1).split(".")) if m else None


def _http(url: str, method: str = "GET"):
    """Body of a GET, or the headers of a HEAD (lower-case keys). curl first: the python.org macOS build has no CA
    certificates until 'Install Certificates.command' is run, so urllib cannot verify HTTPS there."""
    import shutil
    if shutil.which("curl"):
        r = subprocess.run(["curl", "-fsSL", "-m", "6", "-A", "dji-ppk", *(["-I"] if method == "HEAD" else []), url],
                           capture_output=True, text=True, timeout=10)
        if r.returncode != 0:
            raise OSError(f"curl {url}: exit {r.returncode}")
        if method != "HEAD":
            return r.stdout
        return {k.strip().lower(): v.strip() for k, _, v in (l.partition(":") for l in r.stdout.splitlines()) if v}
    import urllib.request
    req = urllib.request.Request(url, method=method, headers={"User-Agent": "dji-ppk"})
    with urllib.request.urlopen(req, timeout=6) as r:
        return {k.lower(): v for k, v in r.headers.items()} if method == "HEAD" else r.read().decode(errors="replace")


def _json(url: str):
    return json.loads(_http(url))


def fetch_latest() -> dict[str, str]:
    """Newest published version of each component; a source that cannot be reached is left out."""
    from concurrent.futures import ThreadPoolExecutor
    from email.utils import parsedate_to_datetime

    def rnxcmp():
        found = re.findall(r"RNXCMP_(\d+(?:\.\d+)+)_src\.tar\.gz", _http("https://terras.gsi.go.jp/ja/crx2rnx.html"))
        return max(found, key=_vtuple)

    sources = {
        "rtklib": lambda: _json("https://api.github.com/repos/rtklibexplorer/RTKLIB/releases/latest")["tag_name"],
        "playwright": lambda: _json("https://pypi.org/pypi/playwright/json")["info"]["version"],
        "rnxcmp": rnxcmp,
        "python": lambda: str(_json("https://endoflife.date/api/python.json")[0]["cycle"]),  # newest released cycle first
        "debian": lambda: (lambda d: f"{d['codename'].lower()} ({d['cycle']})")(_json("https://endoflife.date/api/debian.json")[0]),
        "antex": lambda: parsedate_to_datetime(_http("https://files.igs.org/pub/station/general/igs20.atx", "HEAD")["last-modified"]).strftime("%Y-%m-%d"),
    }
    out: dict[str, str] = {}
    with ThreadPoolExecutor(len(sources)) as pool:
        futures = {k: pool.submit(fn) for k, fn in sources.items()}
        for k, f in futures.items():
            try:
                out[k] = f.result()
            except Exception:  # noqa: BLE001 - offline or the page changed: no notice for this one
                pass
    return out


def latest_versions() -> dict[str, str]:
    import time
    try:
        cached = json.loads(VERSION_CACHE.read_text())
        if time.time() - cached.get("checked", 0) < VERSION_CACHE_HOURS * 3600:
            return cached.get("latest", {})
    except (OSError, ValueError):
        pass
    latest = fetch_latest()
    if latest:
        try:
            VERSION_CACHE.write_text(json.dumps({"checked": time.time(), "latest": latest}, indent=1))
        except OSError:
            pass
    return latest


def current_versions(env: dict[str, str]) -> dict[str, str]:
    """What the images are built from: the pins in the Dockerfiles and .env, and the ANTEX download date."""
    df = (ROOT / "Dockerfile").read_text()
    dfe = (ROOT / "Dockerfile.estpos").read_text()
    debian = re.search(r"FROM debian:(\w+)-slim", df)
    codes = {"bullseye": 11, "bookworm": 12, "trixie": 13, "forky": 14}
    out = {
        "rtklib": env.get("RTKLIB_REF") or re.search(r"ARG RTKLIB_REF=(\S+)", df).group(1),
        "playwright": re.search(r"playwright/python:v([\d.]+)", dfe).group(1),
        "rnxcmp": re.search(r"RNXCMP_([\d.]+)_src", df).group(1),
        "python": re.search(r"FROM python:([\d.]+)-slim", df).group(1),
        "debian": f"{debian.group(1)} ({codes.get(debian.group(1), '?')})",
    }
    created = image_created(f"dji-ppk:{env.get('RTKLIB_REF', 'v2.5.1')}") if docker_available() else None
    if created:
        from datetime import datetime, timezone
        out["antex"] = datetime.fromtimestamp(created, timezone.utc).strftime("%Y-%m-%d")
    return out


def docker_available() -> bool:
    try:
        return subprocess.run(["docker", "version"], capture_output=True, timeout=5).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


UPGRADE_HOW = {
    "rtklib": ("RTKLIB-EX", "set RTKLIB_REF={new} in .env, then ./dji-ppk build"),
    "playwright": ("Playwright", "Dockerfile.estpos: FROM tag and the pip pin to {new}, then ./dji-ppk build"),
    "rnxcmp": ("RNXCMP (crx2rnx)", "Dockerfile: RNXCMP_{new}_src.tar.gz, then ./dji-ppk build"),
    "python": ("Python (image)", "Dockerfile: FROM python:{new}-slim, then ./dji-ppk build"),
    "debian": ("Debian (builder)", "Dockerfile: FROM debian:{new}-slim (both stages' tools must still build), then ./dji-ppk build"),
    "antex": ("IGS ANTEX igs20.atx", "./dji-ppk build --fresh (the download is cached in the image)"),
}


def upgrades(current: dict[str, str], latest: dict[str, str]) -> list[tuple[str, str, str, str]]:
    """(name, current, newest, how) for every component with a newer published version."""
    out = []
    for key, (name, how) in UPGRADE_HOW.items():
        cur, new = current.get(key), latest.get(key)
        if not cur or not new:
            continue
        if key == "antex":
            newer = new > cur  # ISO dates: the file was updated after the image was built
            cur, new = f"image {cur}", f"updated {new}"
        elif key == "debian":
            a, b = re.search(r"\((\d+)\)", cur), re.search(r"\((\d+)\)", new)
            newer = bool(a and b and int(b.group(1)) > int(a.group(1)))
        else:
            a, b = _vtuple(cur), _vtuple(new)
            newer = bool(a and b and b > a)  # a branch such as RTKLIB_REF=main is not compared
        if newer:
            out.append((name, cur, new, how.format(new=latest[key].split()[0])))
    return out


def check_upgrades(env: dict[str, str]) -> None:
    """Print one line per component that has a newer version than the images are built from."""
    if os.environ.get("DJI_PPK_NO_VERSION_CHECK"):
        return
    try:
        found = upgrades(current_versions(env), latest_versions())
    except Exception as exc:  # noqa: BLE001 - never block a run over this
        print(c(f"upgrade check skipped: {exc}", "dim"), file=sys.stderr)
        return
    if not found:
        return
    print(c("upgrades available:", "cyan", "bold"), file=sys.stderr)
    w1, w2 = max(len(f[0]) for f in found), max(len(f"{f[1]} → {f[2]}") for f in found)
    for name, cur, new, how in found:
        print(f"  {name:<{w1}}  {c(cur, 'yellow')} → {c(new, 'green')}{' ' * (w2 - len(f'{cur} → {new}'))}  {c(how, 'dim')}",
              file=sys.stderr)
    print(file=sys.stderr)


# ----------------------------------------------------------------------------- environment

def read_env() -> dict[str, str]:
    out: dict[str, str] = {}
    p = ROOT / ".env"
    if p.exists():
        for line in p.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip().strip('"').strip("'")
    return out


def need_env() -> dict[str, str]:
    if not (ROOT / ".env").exists():
        die(".env is missing: cp .env.example .env and set FLIGHTS_DIR (and ESTPOS_USER / ESTPOS_PASSWORD for ordering)")
    if subprocess.run(["docker", "compose", "version"], capture_output=True).returncode != 0:
        die("docker compose (v2 plugin) is not available; install Docker with the compose plugin")
    _ENV.update(read_env())
    return read_env()


def need_creds(env: dict[str, str]) -> None:
    if not has_creds(env):
        die("ESTPOS_USER / ESTPOS_PASSWORD are not set in .env (needed to order or download a Virtual RINEX)")


def has_creds(env: dict[str, str]) -> bool:
    return bool(env.get("ESTPOS_USER") and env.get("ESTPOS_PASSWORD"))


def image_exists(tag: str) -> bool:
    return subprocess.run(["docker", "image", "inspect", tag], capture_output=True).returncode == 0


def image_created(tag: str) -> float | None:
    r = subprocess.run(["docker", "image", "inspect", "--format", "{{.Created}}", tag], capture_output=True, text=True)
    if r.returncode != 0:
        return None
    from datetime import datetime, timezone
    s = r.stdout.strip()
    s = re.sub(r"(\.\d{6})\d*", r"\1", s).replace("Z", "+00:00")  # trim nanoseconds for fromisoformat
    try:
        return datetime.fromisoformat(s).astimezone(timezone.utc).timestamp()
    except ValueError:
        return None


def newest_source(paths: list[str]) -> float:
    """Newest mtime of the files an image is built from; caches and hidden folders do not count."""
    newest = 0.0
    for p in paths:
        base = ROOT / p
        for f in ([base] if base.is_file() else base.rglob("*")):
            rel = f.relative_to(ROOT).parts
            if any(part.startswith(".") or part == "__pycache__" or part.endswith(".egg-info") for part in rel):
                continue
            if f.is_file():
                newest = max(newest, f.stat().st_mtime)
    return newest


_STALE_WARNED: set[str] = set()


def ensure_images(env: dict[str, str], estpos: bool = False) -> None:
    """Build missing images with visible output (a silent auto-build looks like a hang: RTKLIB compiles for
    minutes) and warn when an image is older than the code it was built from (after a git pull)."""
    need = []
    tag = f"dji-ppk:{env.get('RTKLIB_REF', 'v2.5.1')}"
    checks = [("ppk", tag, ["ppk", "config", "Dockerfile"])]
    if estpos:
        checks.append(("ppk-estpos", "dji-ppk-estpos", ["ppk", "Dockerfile.estpos"]))
    stale = []
    for service, image, sources in checks:
        created = image_created(image)
        if created is None:
            need.append(service)
        elif created < newest_source(sources) and service not in _STALE_WARNED:
            _STALE_WARNED.add(service)
            stale.append(service)
    if need:
        print(c(f"image(s) not built yet: {' '.join(need)}. Building now (first run compiles RTKLIB, several minutes) ...", "yellow"))
    if stale:
        print(c(f"image(s) older than the code: {' '.join(stale)}. Rebuilding (usually well under a minute) ...", "cyan"))
    if need or stale:
        if compose("build", *need, *stale).returncode != 0:
            die("image build failed")


# ----------------------------------------------------------------------------- docker

def compose(*args: str, capture: bool = False) -> subprocess.CompletedProcess:
    cmd = ["docker", "compose", "--profile", "cli", *args]
    return subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=capture, text=capture)


def run_in(service: str, env: dict[str, str], *args: str, capture: bool = False) -> subprocess.CompletedProcess:
    # -T: no pseudo-TTY; stdin detached: containers must never swallow the keystrokes of the menu
    ensure_images(env, estpos=(service == "ppk-estpos"))
    return compose("run", "--rm", "-T", "-e", f"PPK_COLOR={1 if COLOR and not capture else 0}", service, *args, capture=capture)


_ENV: dict[str, str] = {}  # the .env, for path mapping (set by need_env)


def rel_folder(folder: str) -> str:
    """A folder argument as a path relative to FLIGHTS_DIR: a bare name, 'flight/d-rtk3' (a base point inside a
    flight folder), or a host path anywhere under FLIGHTS_DIR."""
    p = Path(folder.rstrip("/"))
    root = Path(_ENV.get("FLIGHTS_DIR") or ".").expanduser()
    try:
        if p.is_absolute() or p.exists():
            return p.resolve().relative_to(root.resolve()).as_posix()
    except ValueError:
        return p.name
    return p.name if ".." in p.parts else p.as_posix()  # not on the host: a name (or sub-path) inside FLIGHTS_DIR


def cpath(folder: str) -> str:
    return f"{FLIGHTS}/{rel_folder(folder)}"


# ----------------------------------------------------------------------------- status

def status_rows(env: dict[str, str], quiet: bool = False) -> list[dict]:
    if not quiet:
        print(c(f"scanning {env.get('FLIGHTS_DIR', '.')} ...", "dim"), file=sys.stderr, flush=True)
    r = run_in("ppk", env, "status", FLIGHTS, "--json", capture=True)
    if r.returncode != 0:
        die("cannot list flights:\n" + (r.stderr or r.stdout))
    try:
        return sort_rows(json.loads(r.stdout))
    except json.JSONDecodeError:
        die("unexpected status output:\n" + r.stdout[:500])
    return []


UNPROCESSABLE = ("no-times",)  # folders that can never be processed: listed last and dimmed, out of the way


def selectable(row: dict) -> bool:
    """A folder that can never be processed cannot be ticked or run: it is listed for information only."""
    return row.get("next") not in UNPROCESSABLE


def toggle(rows: list[dict], ticked: list[bool], indexes: list[int]) -> list[str]:
    """Flip the ticks of `indexes`; returns the folders that were left alone because they cannot be processed."""
    refused = []
    for i in indexes:
        if selectable(rows[i]):
            ticked[i] = not ticked[i]
        else:
            refused.append(rows[i]["folder"])
    return refused


def sort_rows(rows: list[dict]) -> list[dict]:
    """Keep the scan order, but move the folders that can never be processed to the end."""
    return sorted(rows, key=lambda r: r.get("next") in UNPROCESSABLE)


def render_table(rows: list[dict]) -> str:
    if not rows:
        return "no flight folders (OBS/NAV/MRK triplets) found under FLIGHTS_DIR"
    head = ["folder", "sess/photos", "flown", "base", "result", "accuracy flown→PPK", "next"]
    table = [head] + [[r["folder"], count_text(r), r["flown"], r["base"], r["result"], r.get("accuracy") or "", r["next"]]
                      for r in rows]
    widths = [max(len(str(x[i])) for x in table) for i in range(len(head))]
    out = []
    for n, row in enumerate(table):
        cells = [str(v).ljust(w) for v, w in zip(row, widths)]
        if n == 0:
            cells = [c(x, "bold") for x in cells]
        elif row[-1] in UNPROCESSABLE:
            out.append(c("  ".join(cells).rstrip(), "dim"))
            continue
        elif row[-1] in NEXT_STYLE:
            cells[-1] = c(cells[-1].rstrip(), *NEXT_STYLE[row[-1]])
        out.append("  ".join(cells).rstrip())
        if n == 0:
            out.append("  ".join("-" * w for w in widths))
    return "\n".join(out)


def count_text(row: dict) -> str:
    if is_basepoint(row):
        return f"{row['sessions']} log{'s' if row['sessions'] != 1 else ''}"
    return f"{row['sessions']}/{row['photos']}"


def is_basepoint(row: dict) -> bool:
    return row.get("kind") == "basepoint"


def legend() -> str:
    return ("next: " + c("order", *NEXT_STYLE["order"]) + " = no base file yet, " + c("photos", *NEXT_STYLE["photos"])
            + " = photos still missing in the folder (copy finished?), " + c("process", *NEXT_STYLE["process"]) + "/"
            + c("reprocess", *NEXT_STYLE["reprocess"]) + " = run it,\n      " + c("done", *NEXT_STYLE["done"])
            + " = nothing to do, " + c("expired", *NEXT_STYLE["expired"])
            + " = older than 90 days, ESTPOS has no RINEX for it any more (only a base file already in the folder helps),\n      "
            + c("survey", *NEXT_STYLE["survey"]) + " = a D-RTK 3 base point (the station's own logs): order the RINEX, static survey,\n      "
            + c("no-times", *NEXT_STYLE["no-times"]) + " = DJI wrote no exposure times into the MRK: cannot be post-processed")


# ----------------------------------------------------------------------------- actions

def banner(text: str) -> None:
    print(c(f"\n==== {text} ====", "bold", "magenta"))


def act_order(env, folder, *extra):
    need_creds(env)
    rc = run_in("ppk-estpos", env, "estpos-order", cpath(folder), *extra).returncode
    return no_times_skipped(folder) if rc == NO_TIMES else rc


def act_download(env, folder, *extra):
    need_creds(env)
    return run_in("ppk-estpos", env, "estpos-download", cpath(folder), *extra).returncode


def act_dryrun(env, folder, *extra):
    need_creds(env)
    return run_in("ppk-estpos", env, "estpos-order", cpath(folder), "--dry-run", *extra).returncode


def act_window(env, folder, *extra):
    rc = run_in("ppk", env, "estpos-window", cpath(folder), *extra).returncode
    return no_times_skipped(folder) if rc == NO_TIMES else rc


def act_process(env, folder, *extra):
    rc = run_in("ppk", env, "process", cpath(folder), *extra).returncode
    return no_times_skipped(folder) if rc == NO_TIMES else rc


PORTAL_DOWN = 4  # exit code of estpos-order / estpos-download when the ESTPOS backend is unavailable
NO_TIMES = 5  # exit code of estpos-order / estpos-window / process: the MRK has no exposure times (nothing done)


def host_folder(env: dict[str, str], folder: str) -> Path:
    return Path(env.get("FLIGHTS_DIR") or ".").expanduser() / rel_folder(folder)


def folder_is_basepoint(env: dict[str, str], folder: str) -> bool:
    """A folder with the D-RTK 3's own logs, DRTK3_*.OBS or .dat (checked on the host: no container round trip)."""
    try:
        return any(p.is_file() and (p.suffix.lower() == ".dat" or (p.name.upper().startswith("DRTK") and p.suffix.lower() == ".obs"))
                   for p in host_folder(env, folder).iterdir())
    except OSError:
        return False


def survey_flags(env: dict[str, str], folder: str) -> list[str]:
    """The pole height and the coordinates DJI Pilot 2 showed: asked once (on a terminal), remembered in basepoint.json."""
    settings = {}
    jp = host_folder(env, folder) / "basepoint.json"
    try:
        settings = json.loads(jp.read_text())
    except (OSError, ValueError):
        pass
    flags: list[str] = []
    if settings.get("pole_m") is not None and settings.get("shown"):
        return flags
    if not sys.stdin.isatty():
        return flags
    print(c(f"\n{folder}: to turn the survey into Manual Calibration coordinates the tool needs what DJI Pilot 2 showed", "bold"))
    print(c("after a calibration on this marker, this or a later visit (Enter skips: the survey then gives the antenna position only,", "dim"))
    print(c("and you can add the readings later with ./dji-ppk survey <folder> --pole <m> --shown <lat> <lon> <h>):", "dim"))
    try:
        if settings.get("pole_m") is None:
            t = input("  pole height in metres (e.g. 1.8): ").strip().replace(",", ".")
            if t:
                flags += ["--pole", str(float(t))]
        if not settings.get("shown"):
            t = input("  shown coordinates 'lat lon height' (decimal degrees, ellipsoidal metres): ").strip().replace(",", ".")
            parts = t.split()
            if len(parts) == 3:
                flags += ["--shown", *[str(float(x)) for x in parts]]
            elif t:
                print(c("  not three numbers: skipped", "yellow"))
    except ValueError:
        print(c("  not a number: skipped", "yellow"))
    except (EOFError, KeyboardInterrupt):
        print()
    return flags


def act_survey(env: dict[str, str], folder: str, *extra: str) -> int:
    """A D-RTK 3 base point: inspect the logs (ppk image), order the Virtual RINEX (portal image), static survey (ppk image)."""
    flags = [*survey_flags(env, folder), *extra]
    print(c(f"== {folder}: the D-RTK 3 sessions", "bold"))
    if run_in("ppk", env, "base-survey", cpath(folder), "--inspect", *flags).returncode != 0:
        print(c(f"✘ reading the station's logs failed for {folder}", "red", "bold"), file=sys.stderr)
        return 1
    print(c(f"== {folder}: base file", "bold"))
    if has_creds(env):
        rc = run_in("ppk-estpos", env, "estpos-order", cpath(folder)).returncode
        if rc == PORTAL_DOWN:
            return PORTAL_DOWN
        if rc == 3:
            print(c(f"○ {folder}: the order is placed but not ready yet; run again later to download and survey", "yellow"))
            return 3
        if rc != 0:
            print(c(f"✘ ordering the Virtual RINEX failed for {folder}", "red", "bold"), file=sys.stderr)
            return 1
    else:
        print(c("ESTPOS credentials not set in .env: skipping the order step, using whatever base file is in the folder", "yellow"))
    print(c(f"== {folder}: static survey", "bold"))
    if run_in("ppk", env, "base-survey", cpath(folder), *flags).returncode != 0:
        print(c(f"✘ the survey failed for {folder}", "red", "bold"), file=sys.stderr)
        return 1
    try:
        surveyed = json.loads((host_folder(env, folder) / "basepoint.json").read_text()).get("surveyed") or {}
    except (OSError, ValueError):
        surveyed = {}
    if surveyed.get("ground"):
        print(c(f"✔ {folder} surveyed: the Manual Calibration coordinates are in basepoint.txt", "green", "bold"))
    else:
        print(c(f"✔ {folder} surveyed: corrected antenna position in basepoint.txt. For the Manual Calibration ground point add the "
                f"pole height and the coordinates Pilot 2 shows after a calibration on this marker:", "green", "bold"))
        print(c(f"    ./dji-ppk survey {folder} --pole <m> --shown <lat> <lon> <h>", "bold"))
    return 0


def act_run(env: dict[str, str], folder: str) -> int:
    if folder_is_basepoint(env, folder):
        return act_survey(env, folder)
    print(c(f"== {folder}: base file", "bold"))
    if has_creds(env):
        rc = run_in("ppk-estpos", env, "estpos-order", cpath(folder)).returncode
        if rc == PORTAL_DOWN:
            return PORTAL_DOWN
        if rc == NO_TIMES:
            return no_times_skipped(folder)
        if rc == 3:
            print(c(f"○ {folder}: the order is placed but not ready yet; run again later to download and process it", "yellow"))
            return 3
        if rc != 0:
            print(c(f"✘ ordering the Virtual RINEX failed for {folder}", "red", "bold"), file=sys.stderr)
            return 1
    else:
        print(c("ESTPOS credentials not set in .env: skipping the order step, using whatever base file is in the folder", "yellow"))
    print(c(f"== {folder}: processing", "bold"))
    rc = run_in("ppk", env, "process", cpath(folder)).returncode
    if rc == NO_TIMES:
        return no_times_skipped(folder)
    if rc != 0:
        print(c(f"✘ processing failed for {folder}", "red", "bold"), file=sys.stderr)
        return 1
    print(c(f"✔ {folder} finished", "green", "bold"))
    return 0


def no_times_skipped(folder: str) -> int:
    print(c(f"○ {folder}: skipped, the MRK has no exposure times (cannot be post-processed, nothing ordered)", "yellow"))
    return 0


def act_run_all(env: dict[str, str], rows: list[dict] | None = None) -> int:
    rows = rows or status_rows(env)
    pending = [r["folder"] for r, t in zip(rows, initial_ticks(rows)) if t]
    left_out = [r["folder"] for r in rows if default_tick(r) and r["folder"] in excluded()]
    if left_out:
        print(c(f"left out (unticked by you in the menu): {', '.join(left_out)}", "dim"))
    if not pending:
        print(c(f"nothing to do: every folder is done, waiting for photos, expired, unticked by you, "
                f"or has fewer than {MIN_PHOTOS} photos", "green"))
        return 0
    rc = 0
    for i, f in enumerate(pending):
        banner(f)
        r = act_run(env, f)
        if r == PORTAL_DOWN:
            print(c(f"\n✘ the ESTPOS portal backend is down; stopping here ({len(pending) - i - 1} folders not started). "
                    "Orders already placed are reused when you run again later.", "red", "bold"))
            return PORTAL_DOWN
        rc = max(rc, r)
    return rc


def act_watch(env: dict[str, str]) -> int:
    ensure_images(env)
    subprocess.run(["docker", "compose", "up", "-d", "ppk-watch"])
    try:
        return subprocess.run(["docker", "compose", "logs", "-f", "ppk-watch"]).returncode
    except KeyboardInterrupt:
        print()
        return 0


def act_build(fresh: bool = False) -> int:
    """Rebuild both images; fresh also re-downloads what the build caches (IGS ANTEX, base image updates)."""
    return compose("build", *(["--no-cache", "--pull"] if fresh else []), "ppk", "ppk-estpos").returncode


