#!/usr/bin/env python3
"""dji-ppk: one entry point for the whole flow. Runs on the host and drives the two containers.

  ./dji-ppk                     interactive table: ↑↓ move, Space tick/untick, Enter = START (order RINEX + process all ticked)
  ./dji-ppk status              one line per flight folder: sessions, photos, base, result, next step (--json)
  ./dji-ppk run <folder>...     order the Virtual RINEX if needed, then process (geo.txt & co in the folder);
                                the default: ./dji-ppk <folder> does the same
  ./dji-ppk run --all           the same for every folder whose next step is order / process / reprocess
  ./dji-ppk order <folder>      order + download the base only         ./dji-ppk download <folder>  download an existing order (never orders)
  ./dji-ppk process <folder>    process only                           ./dji-ppk window <folder>    print the order parameters
  ./dji-ppk dry-run <folder>    fill the portal form, do not submit    ./dji-ppk watch              start the watcher, follow its log
  ./dji-ppk build               (re)build both images

<folder> is a folder name under FLIGHTS_DIR (see .env) or any path to it. Only python3 and docker compose are needed.
On every start the launcher fetches the git remote, pulls a newer version (clean tree, fast-forward only) and re-runs
itself, then rebuilds an image that is older than the code before using it. --no-update or DJI_PPK_NO_UPDATE=1 skips that.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
os.chdir(ROOT)

COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
_C = {"bold": "1", "dim": "2", "red": "31", "green": "32", "yellow": "33", "cyan": "36", "magenta": "35"}
NEXT_STYLE = {"done": ("green",), "order": ("yellow", "bold"), "photos": ("yellow",), "process": ("cyan", "bold"),
              "reprocess": ("cyan",), "expired": ("red", "bold")}
PENDING = ("order", "process", "reprocess")
FLIGHTS = "/data/flights"


def c(text: str, *styles: str) -> str:
    return "".join(f"\033[{_C[s]}m" for s in styles) + text + "\033[0m" if COLOR and styles else text


def die(msg: str, code: int = 1) -> None:
    print(c("error: ", "red", "bold") + msg, file=sys.stderr)
    sys.exit(code)


# ----------------------------------------------------------------------------- self-update

def _git(*args: str, timeout: int = 30) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], capture_output=True, text=True, timeout=timeout, cwd=ROOT)


def self_update(argv: list[str]) -> None:
    """git fetch; if the remote branch is ahead and the working tree is clean, git pull --ff-only and re-run this
    command with the new code. Anything unusual (offline, local edits, diverged) is reported and skipped."""
    if os.environ.get("DJI_PPK_NO_UPDATE") or not (ROOT / ".git").exists():
        return
    try:
        if _git("rev-parse", "--abbrev-ref", "@{u}").returncode != 0:
            return  # no upstream configured
        fetch = _git("fetch", "--quiet", timeout=40)
        if fetch.returncode != 0:
            print(c("update check skipped: git fetch failed (offline?)", "dim"), file=sys.stderr)
            return
        local = _git("rev-parse", "HEAD").stdout.strip()
        remote = _git("rev-parse", "@{u}").stdout.strip()
        if local == remote:
            return
        base = _git("merge-base", "HEAD", "@{u}").stdout.strip()
        if base != local:
            print(c("update skipped: local commits differ from the remote (git status / git pull by hand)", "yellow"), file=sys.stderr)
            return
        if _git("status", "--porcelain", "--untracked-files=no").stdout.strip():
            print(c("update skipped: you have local changes; commit or stash them, then run again", "yellow"), file=sys.stderr)
            return
        n = _git("rev-list", "--count", "HEAD..@{u}").stdout.strip()
        print(c(f"new version available ({n} commit{'s' if n != '1' else ''}); updating ...", "cyan", "bold"), file=sys.stderr)
        pull = _git("pull", "--ff-only", "--quiet", timeout=120)
        if pull.returncode != 0:
            print(c("update failed: " + (pull.stderr or pull.stdout).strip(), "red"), file=sys.stderr)
            return
        print(c("updated to " + _git("log", "-1", "--format=%h %s").stdout.strip(), "green"), file=sys.stderr)
    except (subprocess.TimeoutExpired, OSError) as exc:
        print(c(f"update check skipped: {exc}", "dim"), file=sys.stderr)
        return
    os.environ["DJI_PPK_NO_UPDATE"] = "1"
    os.execv(sys.executable, [sys.executable, str(Path(__file__).resolve()), *argv])  # run the new launcher


# ----------------------------------------------------------------------------- environment

def read_env() -> dict[str, str]:
    out: dict[str, str] = {}
    p = ROOT / ".env"
    if p.exists():
        for line in p.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip().strip('"').strip("'")
    return out


def need_env() -> dict[str, str]:
    if not (ROOT / ".env").exists():
        die(".env is missing: cp .env.example .env and set FLIGHTS_DIR (and ESTPOS_USER / ESTPOS_PASSWORD for ordering)")
    if subprocess.run(["docker", "compose", "version"], capture_output=True).returncode != 0:
        die("docker compose (v2 plugin) is not available; install Docker with the compose plugin")
    return read_env()


def need_creds(env: dict[str, str]) -> None:
    if not has_creds(env):
        die("ESTPOS_USER / ESTPOS_PASSWORD are not set in .env (needed to order or download a Virtual RINEX)")


def has_creds(env: dict[str, str]) -> bool:
    return bool(env.get("ESTPOS_USER") and env.get("ESTPOS_PASSWORD"))


def image_exists(tag: str) -> bool:
    return subprocess.run(["docker", "image", "inspect", tag], capture_output=True).returncode == 0


def image_created(tag: str) -> float | None:
    r = subprocess.run(["docker", "image", "inspect", "--format", "{{.Created}}", tag], capture_output=True, text=True)
    if r.returncode != 0:
        return None
    from datetime import datetime, timezone
    s = r.stdout.strip()
    s = re.sub(r"(\.\d{6})\d*", r"\1", s).replace("Z", "+00:00")  # trim nanoseconds for fromisoformat
    try:
        return datetime.fromisoformat(s).astimezone(timezone.utc).timestamp()
    except ValueError:
        return None


def newest_source(paths: list[str]) -> float:
    """Newest mtime of the files an image is built from; caches and hidden folders do not count."""
    newest = 0.0
    for p in paths:
        base = ROOT / p
        for f in ([base] if base.is_file() else base.rglob("*")):
            rel = f.relative_to(ROOT).parts
            if any(part.startswith(".") or part == "__pycache__" or part.endswith(".egg-info") for part in rel):
                continue
            if f.is_file():
                newest = max(newest, f.stat().st_mtime)
    return newest


_STALE_WARNED: set[str] = set()


def ensure_images(env: dict[str, str], estpos: bool = False) -> None:
    """Build missing images with visible output (a silent auto-build looks like a hang: RTKLIB compiles for
    minutes) and warn when an image is older than the code it was built from (after a git pull)."""
    need = []
    tag = f"dji-ppk:{env.get('RTKLIB_REF', 'v2.5.1')}"
    checks = [("ppk", tag, ["ppk", "config", "Dockerfile"])]
    if estpos:
        checks.append(("ppk-estpos", "dji-ppk-estpos", ["ppk", "Dockerfile.estpos"]))
    stale = []
    for service, image, sources in checks:
        created = image_created(image)
        if created is None:
            need.append(service)
        elif created < newest_source(sources) and service not in _STALE_WARNED:
            _STALE_WARNED.add(service)
            stale.append(service)
    if need:
        print(c(f"image(s) not built yet: {' '.join(need)}. Building now (first run compiles RTKLIB, several minutes) ...", "yellow"))
    if stale:
        print(c(f"image(s) older than the code: {' '.join(stale)}. Rebuilding (usually well under a minute) ...", "cyan"))
    if need or stale:
        if compose("build", *need, *stale).returncode != 0:
            die("image build failed")


# ----------------------------------------------------------------------------- docker

def compose(*args: str, capture: bool = False) -> subprocess.CompletedProcess:
    cmd = ["docker", "compose", "--profile", "cli", *args]
    return subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=capture, text=capture)


def run_in(service: str, env: dict[str, str], *args: str, capture: bool = False) -> subprocess.CompletedProcess:
    # -T: no pseudo-TTY; stdin detached: containers must never swallow the keystrokes of the menu
    ensure_images(env, estpos=(service == "ppk-estpos"))
    return compose("run", "--rm", "-T", "-e", f"PPK_COLOR={1 if COLOR and not capture else 0}", service, *args, capture=capture)


def cpath(folder: str) -> str:
    return f"{FLIGHTS}/{Path(folder.rstrip('/')).name}"


# ----------------------------------------------------------------------------- status

def status_rows(env: dict[str, str], quiet: bool = False) -> list[dict]:
    if not quiet:
        print(c(f"scanning {env.get('FLIGHTS_DIR', '.')} ...", "dim"), file=sys.stderr, flush=True)
    r = run_in("ppk", env, "status", FLIGHTS, "--json", capture=True)
    if r.returncode != 0:
        die("cannot list flights:\n" + (r.stderr or r.stdout))
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        die("unexpected status output:\n" + r.stdout[:500])
    return []


def render_table(rows: list[dict]) -> str:
    if not rows:
        return "no flight folders (OBS/NAV/MRK triplets) found under FLIGHTS_DIR"
    head = ["folder", "sess/photos", "flown", "base", "result", "accuracy flown→PPK", "next"]
    table = [head] + [[r["folder"], f"{r['sessions']}/{r['photos']}", r["flown"], r["base"], r["result"], r.get("accuracy") or "", r["next"]]
                      for r in rows]
    widths = [max(len(str(x[i])) for x in table) for i in range(len(head))]
    out = []
    for n, row in enumerate(table):
        cells = [str(v).ljust(w) for v, w in zip(row, widths)]
        if n == 0:
            cells = [c(x, "bold") for x in cells]
        elif row[-1] in NEXT_STYLE:
            cells[-1] = c(cells[-1].rstrip(), *NEXT_STYLE[row[-1]])
        out.append("  ".join(cells).rstrip())
        if n == 0:
            out.append("  ".join("-" * w for w in widths))
    return "\n".join(out)


def legend() -> str:
    return ("next: " + c("order", *NEXT_STYLE["order"]) + " = no base file yet, " + c("photos", *NEXT_STYLE["photos"])
            + " = photos still missing in the folder (copy finished?), " + c("process", *NEXT_STYLE["process"]) + "/"
            + c("reprocess", *NEXT_STYLE["reprocess"]) + " = run it,\n      " + c("done", *NEXT_STYLE["done"])
            + " = nothing to do, " + c("expired", *NEXT_STYLE["expired"])
            + " = older than 90 days, ESTPOS has no RINEX for it any more (only a base file already in the folder helps)")


# ----------------------------------------------------------------------------- actions

def banner(text: str) -> None:
    print(c(f"\n==== {text} ====", "bold", "magenta"))


def act_order(env, folder, *extra):
    need_creds(env)
    return run_in("ppk-estpos", env, "estpos-order", cpath(folder), *extra).returncode


def act_download(env, folder, *extra):
    need_creds(env)
    return run_in("ppk-estpos", env, "estpos-download", cpath(folder), *extra).returncode


def act_dryrun(env, folder, *extra):
    need_creds(env)
    return run_in("ppk-estpos", env, "estpos-order", cpath(folder), "--dry-run", *extra).returncode


def act_window(env, folder, *extra):
    return run_in("ppk", env, "estpos-window", cpath(folder), *extra).returncode


def act_process(env, folder, *extra):
    return run_in("ppk", env, "process", cpath(folder), *extra).returncode


PORTAL_DOWN = 4  # exit code of estpos-order / estpos-download when the ESTPOS backend is unavailable


def act_run(env: dict[str, str], folder: str) -> int:
    print(c(f"== {folder}: base file", "bold"))
    if has_creds(env):
        rc = run_in("ppk-estpos", env, "estpos-order", cpath(folder)).returncode
        if rc == PORTAL_DOWN:
            return PORTAL_DOWN
        if rc == 3:
            print(c(f"○ {folder}: the order is placed but not ready yet; run again later to download and process it", "yellow"))
            return 3
        if rc != 0:
            print(c(f"✘ ordering the Virtual RINEX failed for {folder}", "red", "bold"), file=sys.stderr)
            return 1
    else:
        print(c("ESTPOS credentials not set in .env: skipping the order step, using whatever base file is in the folder", "yellow"))
    print(c(f"== {folder}: processing", "bold"))
    if run_in("ppk", env, "process", cpath(folder)).returncode != 0:
        print(c(f"✘ processing failed for {folder}", "red", "bold"), file=sys.stderr)
        return 1
    print(c(f"✔ {folder} finished", "green", "bold"))
    return 0


def act_run_all(env: dict[str, str], rows: list[dict] | None = None) -> int:
    rows = rows or status_rows(env)
    pending = [r["folder"] for r in rows if default_tick(r)]
    if not pending:
        print(c(f"nothing to do: every folder is done, waiting for photos, expired, or has fewer than {MIN_PHOTOS} photos", "green"))
        return 0
    rc = 0
    for i, f in enumerate(pending):
        banner(f)
        r = act_run(env, f)
        if r == PORTAL_DOWN:
            print(c(f"\n✘ the ESTPOS portal backend is down; stopping here ({len(pending) - i - 1} folders not started). "
                    "Orders already placed are reused when you run again later.", "red", "bold"))
            return PORTAL_DOWN
        rc = max(rc, r)
    return rc


def act_watch(env: dict[str, str]) -> int:
    ensure_images(env)
    subprocess.run(["docker", "compose", "up", "-d", "ppk-watch"])
    try:
        return subprocess.run(["docker", "compose", "logs", "-f", "ppk-watch"]).returncode
    except KeyboardInterrupt:
        print()
        return 0


def act_build() -> int:
    return compose("build", "ppk", "ppk-estpos").returncode


# ----------------------------------------------------------------------------- menu

def parse_toggles(text: str, n: int) -> list[int] | None:
    """'1 3' or '2-4' -> zero-based indexes; None when the text is not a toggle expression."""
    idx: list[int] = []
    for tok in text.split():
        m = re.fullmatch(r"(\d+)(?:-(\d+))?", tok)
        if not m:
            return None
        a, b = int(m.group(1)), int(m.group(2) or m.group(1))
        for i in range(a, b + 1):
            if 1 <= i <= n:
                idx.append(i - 1)
            else:
                print(c(f"no folder {i}", "yellow"))
    return idx


def menu_text(env: dict[str, str]) -> None:
    rows = status_rows(env)
    ticked = [default_tick(r) for r in rows]

    def rescan():
        nonlocal rows, ticked
        rows = status_rows(env)
        ticked = [default_tick(r) for r in rows]

    while True:
        if not rows:
            print("no flight folders found under FLIGHTS_DIR")
            return
        print("\n" + c("Flight folders under FLIGHTS_DIR", "bold"))
        print(render_table(rows))
        print(legend())
        print()
        for i, r in enumerate(rows):
            mark = c("x", "green") if ticked[i] else " "
            print(f"  {i + 1:2d}) [{mark}] {r['folder']}  " + c(f"(next: {r['next']})", "dim"))
        print()
        print(c("Tick:", "bold") + " numbers toggle (" + c("1 3", "bold") + " or " + c("2-4", "bold") + "), "
              + c("a", "bold") + " = all pending, " + c("A", "bold") + " = all, " + c("n", "bold") + " = none")
        print(c("Then:", "bold") + " " + c("r", "bold") + " = run ticked (order base if needed + process)   "
              + c("d", "bold") + " = download base only   " + c("o", "bold") + " = order base only   " + c("p", "bold") + " = process only")
        print("      " + c("w", "bold") + " = show order parameters   " + c("s", "bold") + " = rescan   "
              + c("W", "bold") + " = start the watcher   " + c("q", "bold") + " = quit")
        try:
            text = input(c("> ", "bold")).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if text in ("q", "Q"):
            return
        if text in ("s", "S"):
            rescan()
        elif text == "W":
            act_watch(env)
            rescan()
        elif text == "a":
            ticked = [r["next"] in PENDING for r in rows]
        elif text == "A":
            ticked = [True] * len(rows)
        elif text in ("n", "N"):
            ticked = [False] * len(rows)
        elif text in ("r", "d", "o", "p", "w"):
            picked = [r["folder"] for r, t in zip(rows, ticked) if t]
            if not picked:
                print(c("nothing ticked", "yellow"))
                continue
            action = {"r": act_run, "d": act_download, "o": act_order, "p": act_process, "w": act_window}[text]
            for f in picked:
                banner(f)
                rc = action(env, f)
                if rc == 3 and text == "d":
                    print(c(f"○ {f}: not ordered yet, use r (run) or o (order) to order it", "yellow"))
                elif rc != 0:
                    print(c(f"✘ {f} failed", "red", "bold"))
            if text != "w":
                rescan()
        else:
            toggles = parse_toggles(text, len(rows))
            if toggles is None:
                print(c(f"unknown input {text!r}", "yellow"))
                continue
            for i in toggles:
                ticked[i] = not ticked[i]


# ----------------------------------------------------------------------------- menu (pure python, ANSI)

MIN_PHOTOS = 10  # folders with fewer photos are test shots or aborted copies: not ticked by default


def default_tick(row: dict) -> bool:
    """Ticked by default: something to do, not expired, at least MIN_PHOTOS photos in the folder."""
    return row["next"] in PENDING and row["photos"] >= MIN_PHOTOS


def why_not(row: dict) -> str:
    if row["next"] == "expired":
        return "older than 90 days, no RINEX available"
    if row["next"] == "done":
        return "done"
    if row["next"] == "photos":
        return "photos still missing"
    if row["photos"] < MIN_PHOTOS:
        return f"only {row['photos']} photos"
    return ""


def read_key() -> str:
    """One key press: 'UP', 'DOWN', 'ENTER', 'SPACE', 'ESC' or the character itself."""
    import select
    import termios
    import tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        ch = os.read(fd, 1)
        if ch == b"\x1b":
            seq = b""
            while select.select([fd], [], [], 0.05)[0] and len(seq) < 6:
                seq += os.read(fd, 1)
                if seq[-1:].isalpha() or seq.endswith(b"~"):
                    break
            return {b"[A": "UP", b"[B": "DOWN", b"OA": "UP", b"OB": "DOWN"}.get(seq, "ESC")
        if ch in (b"\r", b"\n"):
            return "ENTER"
        if ch == b" ":
            return "SPACE"
        if ch in (b"\x03", b"\x04"):
            return "q"
        return ch.decode("utf-8", "ignore")
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def _term_width() -> int:
    try:
        return os.get_terminal_size().columns
    except OSError:
        return 120


def _table_lines(rows: list[dict], ticked: list[bool], cursor: int, width: int) -> list[str]:
    head = ["", "folder", "sessions/photos", "flown", "base", "status", "accuracy flown→PPK"]
    data = []
    for r, t in zip(rows, ticked):
        status = r["result"] if r["next"] in ("done", "reprocess", "photos") else {"order": "needs RINEX + processing", "process": "needs processing",
                                                                         "photos": "waiting for photos", "expired": "expired"}.get(r["next"], r["next"])
        if r["next"] == "reprocess":
            status = "needs reprocessing (inputs changed)"
        reason = why_not(r)
        if reason and not t and reason != "done":
            status += f"  [skipped: {reason}]"
        data.append(["[x]" if t else "[ ]", r["folder"], f"{r['sessions']}/{r['photos']}", r["flown"], r["base"], status,
                     r.get("accuracy") or ""])
    widths = [max(len(str(x[i])) for x in [head] + data) for i in range(len(head))]
    widths[4] = min(widths[4], 28)  # base names are short; explanations get cut, they repeat in the status column
    fixed = sum(widths) - widths[5] + 2 * (len(head) - 1) + 2
    widths[5] = max(30, min(widths[5], width - fixed))  # the status column absorbs the terminal width

    def cells(row):
        out = []
        for i, val in enumerate(row):
            val = str(val)
            if len(val) > widths[i]:
                val = val[: widths[i] - 1] + "…"
            out.append(val.ljust(widths[i]))
        return out

    lines = ["  " + c("  ".join(cells(head)), "bold")]
    for i, (row, r) in enumerate(zip(data, rows)):
        cs = cells(row)
        plain = "  ".join(cs)
        if i == cursor:
            lines.append(c("› ", "bold", "cyan") + (("\033[7m" + plain + "\033[0m") if COLOR else plain))
            continue
        if row[0] == "[x]":
            cs[0] = "[" + c("x", "green", "bold") + "]"
        style = ("red", "bold") if "not cm-accurate" in row[5] else NEXT_STYLE.get(r["next"], ())
        cs[5] = c(cs[5].rstrip(), *style) + " " * (widths[5] - len(cs[5].rstrip())) if style else cs[5]
        lines.append("  " + "  ".join(cs))
    return lines


def _draw(rows, ticked, cursor, msg: str) -> None:
    width = _term_width()
    n = sum(ticked)
    sys.stdout.write("\033[2J\033[H")
    print(c("dji-ppk", "bold", "magenta") + "  " + c("Flight folders under FLIGHTS_DIR", "bold"))
    print(c("For every ticked folder: order the Virtual RINEX from ESTPOS (or reuse an existing order), download it, run PPK, "
            "write geo.txt.", "dim"))
    print()
    if not rows:
        print("no flight folders (OBS/NAV/MRK triplets) found under FLIGHTS_DIR")
    else:
        print("\n".join(_table_lines(rows, ticked, cursor, width)))
    print()
    label = f"  ▶  START: order RINEX + process {n} ticked folder{'s' if n != 1 else ''}  " if n else "  ▶  START  (nothing ticked)  "
    bar = "─" * (len(label) + 2)
    if COLOR:
        print("  ┌" + bar + "┐")
        print("  │ " + ("\033[7;32;1m" if n else "\033[2m") + label + "\033[0m" + " │")
        print("  └" + bar + "┘")
    else:
        print("  ┌" + bar + "┐")
        print("  │ " + label + " │")
        print("  └" + bar + "┘")
    print()
    print(c("↑↓", "bold") + " move   " + c("Space", "bold") + " tick / untick   " + c("Enter", "bold") + " START   "
          + c("r", "bold") + " refresh the table   " + c("q", "bold") + " quit")
    print(c(f"Pre-ticked: everything that needs RINEX or processing, except folders older than 90 days (no RINEX on ESTPOS) "
            f"and folders with fewer than {MIN_PHOTOS} photos.", "dim"))
    if msg:
        print()
        print(c(msg, "yellow"))
    sys.stdout.flush()


def menu(env: dict[str, str]) -> None:
    """Menu; falls back to the typed menu when there is no terminal (pipes) or on Windows."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return menu_text(env)
    try:
        import termios  # noqa: F401
    except ImportError:
        return menu_text(env)
    rows = status_rows(env)
    ticked = [default_tick(r) for r in rows]
    cursor, msg = 0, ""

    def rescan():
        nonlocal rows, ticked, cursor
        rows = status_rows(env)
        ticked = [default_tick(r) for r in rows]
        cursor = min(cursor, max(0, len(rows) - 1))

    while True:
        _draw(rows, ticked, cursor, msg)
        msg = ""
        k = read_key()
        if k in ("q", "ESC"):
            sys.stdout.write("\033[2J\033[H")
            return
        if k == "r":
            rescan()
        elif not rows:
            continue
        elif k == "UP":
            cursor = (cursor - 1) % len(rows)
        elif k == "DOWN":
            cursor = (cursor + 1) % len(rows)
        elif k == "SPACE":
            ticked[cursor] = not ticked[cursor]
        elif k == "ENTER":
            folders = [r["folder"] for r, t in zip(rows, ticked) if t]
            if not folders:
                msg = "nothing ticked: move to a folder and press Space, then Enter"
                continue
            sys.stdout.write("\033[2J\033[H")
            failed, waiting, stopped = [], [], False
            for i, f in enumerate(folders, 1):
                print(c(f"\n==== [{i}/{len(folders)}] {f} ====", "bold", "magenta"))
                rc = act_run(env, f)
                if rc == PORTAL_DOWN:
                    print(c(f"\n✘ the ESTPOS portal backend is down (X-pos not reachable). Stopping here; "
                            f"{len(folders) - i} folder{'s' if len(folders) - i != 1 else ''} not started. "
                            "Try again later: orders already placed are reused, nothing is ordered twice.", "red", "bold"))
                    stopped = True
                    break
                if rc == 3:
                    waiting.append(f)
                elif rc != 0:
                    failed.append(f)
            print()
            if not stopped:
                if failed:
                    print(c(f"✘ {len(failed)} of {len(folders)} folders failed: " + ", ".join(failed), "red", "bold"))
                if waiting:
                    print(c(f"○ {len(waiting)} order{'s' if len(waiting) != 1 else ''} placed but not ready yet: " + ", ".join(waiting)
                            + ". Press START again later.", "yellow"))
                if not failed and not waiting:
                    print(c(f"✔ all {len(folders)} folders finished", "green", "bold"))
            try:
                input(c("\nPress Enter to return to the table ...", "dim"))
            except (EOFError, KeyboardInterrupt):
                pass
            rescan()


# ----------------------------------------------------------------------------- main

def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="dji-ppk", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    s = sub.add_parser("status")
    s.add_argument("--json", action="store_true")
    s = sub.add_parser("run")
    s.add_argument("folders", nargs="*")
    s.add_argument("--all", action="store_true")
    for name in ("order", "download", "process", "window", "dry-run"):
        s = sub.add_parser(name)
        s.add_argument("folder")
        s.add_argument("extra", nargs=argparse.REMAINDER)
    sub.add_parser("watch")
    sub.add_parser("build")
    known = {"status", "run", "order", "download", "process", "window", "dry-run", "watch", "build", "-h", "--help"}
    if argv and argv[0] not in known and not argv[0].startswith("-"):
        argv = ["run", *argv]  # ./dji-ppk <folder> ... = run: the default is to do everything
    if "--no-update" in argv:
        argv = [x for x in argv if x != "--no-update"]
    elif not argv or argv[0] not in ("-h", "--help"):
        self_update(argv)  # pulls a newer version and re-runs itself; images are rebuilt on first use when stale
    a = ap.parse_args(argv)

    if a.cmd is None:
        menu(need_env())
        return 0
    if a.cmd == "build":
        return act_build()
    env = need_env()
    if a.cmd == "status":
        rows = status_rows(env)
        if a.json:
            print(json.dumps(rows, indent=1))
        else:
            print(render_table(rows))
            print()
            print(legend())
        return 0
    if a.cmd == "watch":
        return act_watch(env)
    if a.cmd == "run":
        if a.all:
            return act_run_all(env)
        if not a.folders:
            die("usage: ./dji-ppk run <folder>... | --all")
        rc = 0
        for f in a.folders:
            banner(f)
            rc = max(rc, act_run(env, f))
        return rc
    fn = {"order": act_order, "download": act_download, "process": act_process, "window": act_window, "dry-run": act_dryrun}[a.cmd]
    return fn(env, a.folder, *a.extra)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print()
        sys.exit(130)
