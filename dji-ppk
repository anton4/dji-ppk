def parse_toggles(text: str, n: int) -> list[int] | None:
    """'1 3' or '2-4' -> zero-based indexes; None when the text is not a toggle expression."""
    idx: list[int] = []
    for tok in text.split():
        m = re.fullmatch(r"(\d+)(?:-(\d+))?", tok)
        if not m:
            return None
        a, b = int(m.group(1)), int(m.group(2) or m.group(1))
        for i in range(a, b + 1):
            if 1 <= i <= n:
                idx.append(i - 1)
            else:
                print(c(f"no folder {i}", "yellow"))
    return idx


def menu_text(env: dict[str, str]) -> None:
    rows = status_rows(env)
    ticked = initial_ticks(rows)

    def rescan():
        nonlocal rows, ticked
        rows = status_rows(env)
        ticked = initial_ticks(rows)

    while True:
        if not rows:
            print("no flight folders found under FLIGHTS_DIR")
            return
        print("\n" + c("Flight folders under FLIGHTS_DIR", "bold"))
        print(render_table(rows))
        print(legend())
        print()
        for i, r in enumerate(rows):
            mark = c("x", "green") if ticked[i] else " " if selectable(r) else c("-", "dim")
            print(f"  {i + 1:2d}) [{mark}] {r['folder']}  " + c(f"(next: {r['next']})", "dim"))
        print()
        print(c("Tick:", "bold") + " numbers toggle (" + c("1 3", "bold") + " or " + c("2-4", "bold") + "), "
              + c("a", "bold") + " = all pending, " + c("A", "bold") + " = all (that can be processed), " + c("n", "bold") + " = none")
        print(c("Then:", "bold") + " " + c("r", "bold") + " = run ticked (order base if needed + process)   "
              + c("d", "bold") + " = download base only   " + c("o", "bold") + " = order base only   " + c("p", "bold") + " = process only")
        print("      " + c("w", "bold") + " = show order parameters   " + c("s", "bold") + " = rescan   "
              + c("W", "bold") + " = start the watcher   " + c("q", "bold") + " = quit")
        try:
            text = input(c("> ", "bold")).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if text in ("q", "Q"):
            return
        if text in ("s", "S"):
            rescan()
        elif text == "W":
            act_watch(env)
            rescan()
        elif text == "a":
            ticked = [r["next"] in PENDING for r in rows]
            remember(rows, ticked)
        elif text == "A":
            ticked = [selectable(r) for r in rows]
            remember(rows, ticked)
        elif text in ("n", "N"):
            ticked = [False] * len(rows)
            remember(rows, ticked)
        elif text in ("r", "d", "o", "p", "w"):
            picked = [r["folder"] for r, t in zip(rows, ticked) if t]
            if not picked:
                print(c("nothing ticked", "yellow"))
                continue
            action = {"r": act_run, "d": act_download, "o": act_order, "p": act_process, "w": act_window}[text]
            for f in picked:
                banner(f)
                rc = action(env, f)
                if rc == 3 and text == "d":
                    print(c(f"○ {f}: not ordered yet, use r (run) or o (order) to order it", "yellow"))
                elif rc != 0:
                    print(c(f"✘ {f} failed", "red", "bold"))
            if text != "w":
                rescan()
        else:
            toggles = parse_toggles(text, len(rows))
            if toggles is None:
                print(c(f"unknown input {text!r}", "yellow"))
                continue
            for f in toggle(rows, ticked, toggles):
                print(c(f"{f}: MRK has no exposure times, it cannot be processed (not ticked)", "yellow"))
            remember(rows, ticked)


