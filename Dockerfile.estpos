# Portal automation image: Playwright + Chromium + the ppk package (no RTKLIB).
# Used by the `ppk-estpos` compose service for `ppk estpos-order` / `ppk estpos-download`.
# The base image ships browsers matching its Playwright version; pin the python package to the same
# version so no browser download happens and code changes rebuild in seconds.
FROM mcr.microsoft.com/playwright/python:v1.63.0-noble

RUN pip install --no-cache-dir playwright==1.63.0

WORKDIR /app
COPY ppk /app/ppk
RUN pip install --no-cache-dir --no-deps /app/ppk

ENV PPK_IN_PLACE=1
ENTRYPOINT ["ppk"]
CMD ["--help"]
